{
  "name": "@pritzlaff/gantt",
  "version": "1.0.2",
  "description": "A Gantt chart driven by one markdown file: a local viewer that saves back to the file, plus card.json and badge.svg summaries.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronp/gantt.git"
  },
  "homepage": "https://aaronp.github.io/gantt/",
  "type": "module",
  "bin": {
    "gantt": "bin/gantt.mjs"
  },
  "files": [
    "bin",
    "index.html",
    "card.html",
    "card.js",
    "support.js",
    "vendor",
    "spec.md"
  ],
  "scripts": {
    "test": "node --test card.test.mjs core.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
